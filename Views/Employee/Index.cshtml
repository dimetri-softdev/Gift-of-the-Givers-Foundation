@model IReadOnlyCollection<GiftOfTheGivers.Models.Volunteer>

@{
    ViewData["Title"] = "Employee Dashboard";
}

<section class="min-h-screen bg-slate-50 py-10">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-5 rounded-2xl bg-gradient-to-r from-slate-950 via-slate-900 to-emerald-950 p-6 text-white shadow-xl sm:flex-row sm:items-center sm:justify-between sm:p-8">
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
                    Internal operations
                </span>
                <h1 class="mt-3 text-3xl font-black tracking-tight">Employee Dashboard</h1>
                <p class="mt-2 max-w-2xl text-sm text-slate-300">Monitor active relief missions, donor submissions, and registered field volunteers.</p>
            </div>
            <a asp-action="CreateProject" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-emerald-500 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-emerald-400">
                Post New Relief Project
            </a>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-900">
                @successMessage
            </div>
        }

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Total donations received</p>
                <p class="mt-3 text-3xl font-black text-gray-900">R @(((decimal)ViewBag.TotalDonations).ToString("N2"))</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Active relief projects</p>
                <p class="mt-3 text-3xl font-black text-gray-900">@ViewBag.ActiveProjects</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Registered volunteers</p>
                <p class="mt-3 text-3xl font-black text-gray-900">@ViewBag.VolunteerCount</p>
            </article>
        </div>

        <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
            <div class="flex flex-col gap-2 border-b border-gray-200 px-6 py-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Volunteer operations</p>
                    <h2 class="mt-1 text-xl font-black text-gray-900">Registered Volunteer Applications</h2>
                    <p class="mt-1 text-sm text-gray-600">List of registered volunteers ready for mission deployment.</p>
                </div>
                <span class="text-sm text-gray-500">@Model.Count volunteer@(Model.Count == 1 ? "" : "s")</span>
            </div>

            @if (Model.Count > 0)
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                        <thead class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500">
                            <tr>
                                <th scope="col" class="px-6 py-4">Volunteer name</th>
                                <th scope="col" class="px-6 py-4">Region</th>
                                <th scope="col" class="px-6 py-4">Skill category</th>
                                <th scope="col" class="px-6 py-4">Availability</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-gray-700">
                            @foreach (var volunteer in Model)
                            {
                                <tr>
                                    <td class="whitespace-nowrap px-6 py-4 font-semibold text-gray-900">@volunteer.FullName</td>
                                    <td class="whitespace-nowrap px-6 py-4">@volunteer.Region</td>
                                    <td class="whitespace-nowrap px-6 py-4">@volunteer.SkillCategory</td>
                                    <td class="whitespace-nowrap px-6 py-4">@volunteer.Availability</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="px-6 py-12 text-center text-sm text-gray-500">No volunteer applications submitted yet.</p>
            }
        </section>
    </div>
</section>
