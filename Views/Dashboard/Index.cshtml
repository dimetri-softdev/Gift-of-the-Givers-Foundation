@model IEnumerable<GiftOfTheGivers.Models.Volunteer>

@{
    ViewData["Title"] = "Employee Operations Dashboard";
}

<section class="min-h-screen bg-slate-50 py-10">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-5 rounded-2xl bg-gradient-to-r from-slate-950 via-slate-900 to-emerald-950 p-6 text-white shadow-xl sm:flex-row sm:items-center sm:justify-between sm:p-8">
            <div>
                <span class="inline-flex rounded-full border border-emerald-300/30 bg-emerald-300/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-emerald-200">Internal operations</span>
                <h1 class="mt-3 text-3xl font-black tracking-tight">Employee Operations Dashboard</h1>
                <p class="mt-2 text-sm text-slate-300">Manage ongoing relief missions, review donations, and monitor volunteer deployment.</p>
            </div>
            <a asp-controller="Employee" asp-action="CreateProject" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-emerald-500 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-emerald-400">
                Post New Relief Project
            </a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Active relief projects</p>
                <p class="mt-3 text-3xl font-black text-gray-900">@ViewBag.ActiveProjectsCount</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Registered volunteers</p>
                <p class="mt-3 text-3xl font-black text-gray-900">@ViewBag.TotalVolunteersCount</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Donations (last 30 days)</p>
                <p class="mt-3 text-3xl font-black text-gray-900">R @(((decimal)ViewBag.MonthlyDonationsTotal).ToString("N2"))</p>
            </article>
        </div>

        <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-6 py-5">
                <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Volunteer operations</p>
                <h2 class="mt-1 text-xl font-black text-gray-900">Volunteer Operations Roster</h2>
                <p class="mt-1 text-sm text-gray-600">Registered volunteers and their current project assignments.</p>
            </div>
            @if (Model.Any())
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                        <thead class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500">
                            <tr>
                                <th scope="col" class="px-6 py-4">Volunteer</th>
                                <th scope="col" class="px-6 py-4">Region</th>
                                <th scope="col" class="px-6 py-4">Skill</th>
                                <th scope="col" class="px-6 py-4">Availability</th>
                                <th scope="col" class="px-6 py-4">Assigned mission</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-gray-700">
                            @foreach (var volunteer in Model)
                            {
                                <tr>
                                    <td class="whitespace-nowrap px-6 py-4 font-semibold text-gray-900">@volunteer.FullName</td>
                                    <td class="whitespace-nowrap px-6 py-4">@volunteer.Region</td>
                                    <td class="whitespace-nowrap px-6 py-4">@volunteer.SkillCategory</td>
                                    <td class="whitespace-nowrap px-6 py-4">@volunteer.Availability</td>
                                    <td class="px-6 py-4">@(volunteer.AssignedProject?.Title ?? "Unassigned")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="px-6 py-12 text-center text-sm text-gray-500">No volunteer applications have been submitted yet.</p>
            }
        </section>
    </div>
</section>
