@{
    ViewData["Title"] = "Home - Emergency Disaster Relief";
}

<!-- Hero Section -->
<section class="relative bg-gray-900 text-white min-h-[500px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-30 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-900/80 to-transparent z-10"></div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="max-w-2xl space-y-6">
            <span class="inline-block text-xs font-semibold tracking-widest text-emerald-400 uppercase bg-emerald-950/80 px-3 py-1 rounded-full border border-emerald-800">
                Disaster Response & Humanitarian Aid
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
                Swift Aid. <br />
                Real Hope. <br />
                <span class="text-amber-400">Direct Impact.</span>
            </h1>
            <p class="text-base text-gray-300 font-normal leading-relaxed">
                Gift of the Givers delivers emergency relief to communities in crisis — fast, transparent, and accountable.
            </p>

            <div class="flex flex-wrap gap-4 pt-2">
                <a asp-controller="Donate" asp-action="Index" class="bg-amber-400 hover:bg-amber-500 text-gray-950 font-bold px-6 py-3 rounded-md text-sm shadow-md transition-colors no-underline">
                    Donate Funds
                </a>
                <a asp-controller="Volunteer" asp-action="Index" class="border border-white hover:bg-white/10 text-white font-semibold px-6 py-3 rounded-md text-sm transition-colors no-underline">
                    Become a Volunteer
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Key Metrics Counter Banner -->
<section class="bg-emerald-700 text-white py-10 border-b border-emerald-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="space-y-1">
                <div class="text-3xl sm:text-4xl font-extrabold tracking-tight">100k+</div>
                <div class="text-xs font-medium text-emerald-100 uppercase tracking-wider">Meals Distributed</div>
            </div>
            <div class="space-y-1">
                <div class="text-3xl sm:text-4xl font-extrabold tracking-tight">50+</div>
                <div class="text-xs font-medium text-emerald-100 uppercase tracking-wider">Active Volunteers</div>
            </div>
            <div class="space-y-1">
                <div class="text-3xl sm:text-4xl font-extrabold tracking-tight">R10M+</div>
                <div class="text-xs font-medium text-emerald-100 uppercase tracking-wider">Aid Dispatched</div>
            </div>
            <div class="space-y-1">
                <div class="text-3xl sm:text-4xl font-extrabold tracking-tight">32</div>
                <div class="text-xs font-medium text-emerald-100 uppercase tracking-wider">Years of Service</div>
            </div>
        </div>
    </div>
</section>