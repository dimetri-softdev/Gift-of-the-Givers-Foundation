@{
    ViewData["Title"] = "Home - Emergency Disaster Relief";
}

<!-- Hero Section -->
<section class="relative bg-gray-950 text-white min-h-[580px] flex items-center overflow-hidden font-sans">
    <div class="absolute inset-0 z-0 opacity-25 bg-cover bg-center scale-105 transform transition-transform duration-1000" style="background-image: url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/85 to-transparent z-10"></div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
        <div class="max-w-2xl space-y-6">

            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/90 text-emerald-400 border border-emerald-800/80 backdrop-blur-sm text-xs font-bold tracking-wider uppercase shadow-md">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Disaster Response & Humanitarian Aid
            </div>

            <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight text-white">
                Swift Aid. <br />
                Real Hope. <br />
                <span class="text-amber-400">Direct Impact.</span>
            </h1>

            <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed">
                Gift of the Givers delivers life-saving emergency assistance to communities in crisis — fast, transparent, and accountable.
            </p>

            <!-- Hero Action CTAs -->
            <div class="flex flex-wrap items-center gap-4 pt-4">
                <a asp-controller="Donate" asp-action="Index" class="inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-500 text-gray-950 font-extrabold px-7 py-4 rounded-xl text-sm shadow-xl shadow-amber-500/10 transition-all hover:-translate-y-0.5 active:scale-95 no-underline">
                    <span>Donate Funds</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
                <a asp-controller="Volunteer" asp-action="Index" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur border border-white/20 text-white font-bold px-7 py-4 rounded-xl text-sm transition-all hover:-translate-y-0.5 active:scale-95 no-underline">
                    Become a Volunteer
                </a>
            </div>

        </div>
    </div>
</section>

<!-- Key Metrics Counter Banner -->
<section class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-emerald-900 text-white py-12 border-y border-emerald-600/50 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">

            <div class="space-y-1 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-amber-300">100k+</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Meals Distributed</div>
            </div>

            <div class="space-y-1 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-white">50+</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Active Volunteers</div>
            </div>

            <div class="space-y-1 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-amber-300">R10M+</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Aid Dispatched</div>
            </div>

            <div class="space-y-1 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-white">32</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Years of Service</div>
            </div>

        </div>
    </div>
</section>

<!-- Core Pillars Section -->
<section class="py-20 bg-gray-50/50 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Our Core Pillars</span>
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">How We Serve Communities</h2>
            <p class="text-sm sm:text-base text-gray-600">Rapid emergency response, sustainable community upliftment, and complete donor accountability.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            <!-- Pillar 1 -->
            <div class="bg-white p-8 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-shadow space-y-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Rapid Response</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Deploying specialized medical teams, food parcels, and clean water within hours of natural disasters or localized emergencies.
                </p>
            </div>

            <!-- Pillar 2 -->
            <div class="bg-white p-8 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-shadow space-y-4">
                <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Volunteer Network</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Mobilizing thousands of passionate volunteers across medical, logistics, driving, and administrative disciplines.
                </p>
            </div>

            <!-- Pillar 3 -->
            <div class="bg-white p-8 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-shadow space-y-4">
                <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Section 18A Tax Certificates</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Full transparency with immediate official tax receipt generation for every monetary contribution.
                </p>
            </div>

        </div>

    </div>
</section>