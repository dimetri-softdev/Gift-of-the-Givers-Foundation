@model IEnumerable<GiftOfTheGivers.Models.ReliefProject>

@{
    ViewData["Title"] = "Home - Emergency Disaster Relief";
}

<!-- Hero Section -->
<section class="relative bg-gray-950 text-white min-h-[600px] flex items-center overflow-hidden font-sans">
    <div class="absolute inset-0 z-0 opacity-30 bg-cover bg-center scale-105 transform transition-transform duration-1000" style="background-image: url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/90 to-transparent z-10"></div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
        <div class="max-w-2xl space-y-6">

            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/90 text-emerald-400 border border-emerald-800/80 backdrop-blur-sm text-xs font-bold tracking-wider uppercase shadow-md">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Disaster Response & Humanitarian Aid
            </div>

            <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight text-white">
                Swift Aid. <br />
                Real Hope. <br />
                <span class="text-amber-400">Direct Impact.</span>
            </h1>

            <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed">
                Gift of the Givers delivers life-saving emergency assistance to communities in crisis — fast, transparent, and accountable.
            </p>

            <!-- Hero Action CTAs -->
            <div class="flex flex-wrap items-center gap-4 pt-4">
                <a asp-controller="Donate" asp-action="Index" class="inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-500 text-gray-950 font-extrabold px-7 py-4 rounded-xl text-sm shadow-xl shadow-amber-500/10 transition-all hover:-translate-y-0.5 active:scale-95 no-underline">
                    <span>Donate Funds</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
                <a asp-controller="Volunteer" asp-action="Register" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur border border-white/20 text-white font-bold px-7 py-4 rounded-xl text-sm transition-all hover:-translate-y-0.5 active:scale-95 no-underline">
                    Become a Volunteer
                </a>
            </div>

        </div>
    </div>
</section>

<!-- Key Metrics Counter Banner -->
<section class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-emerald-900 text-white py-12 border-y border-emerald-600/50 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">

            <div class="space-y-1 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-all">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-amber-300">100k+</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Meals Distributed</div>
            </div>

            <div class="space-y-1 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-all">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-white">50+</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Active Volunteers</div>
            </div>

            <div class="space-y-1 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-all">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-amber-300">R10M+</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Aid Dispatched</div>
            </div>

            <div class="space-y-1 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-all">
                <div class="text-3xl sm:text-5xl font-black tracking-tight text-white">32</div>
                <div class="text-xs font-bold text-emerald-100 uppercase tracking-widest mt-1">Years of Service</div>
            </div>

        </div>
    </div>
</section>

<!-- Active Relief Projects Section -->
<section class="py-20 bg-gray-50/50 font-sans border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-12 gap-4">
            <div class="space-y-2">
                <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Urgent Response</span>
                <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">Active Relief Operations</h2>
                <p class="text-xs sm:text-sm text-gray-500 max-w-xl">
                    Support our ongoing emergency interventions across regions in critical need.
                </p>
            </div>
            <a asp-controller="Project" asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-extrabold text-emerald-700 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 px-4 py-2.5 rounded-xl border border-emerald-200 transition-all no-underline shrink-0">
                View All Operations &rarr;
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var project in Model)
                {
                    double progressPercent = project.TargetAmount > 0
                        ? Math.Min(100.0, Math.Round((double)(project.RaisedAmount / project.TargetAmount * 100), 1))
                        : 0.0;

                    <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-gray-200/80 overflow-hidden flex flex-col justify-between transition-all duration-300 group">
                        <div>
                            <!-- Project Image Header & Badges -->
                            <div class="relative h-48 bg-gray-900 overflow-hidden">
                                @if (!string.IsNullOrEmpty(project.ImageUrl))
                                {
                                    <img src="@project.ImageUrl" alt="@project.Title" class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-500" />
                                }
                                else
                                {
                                    <img src="https://images.unsplash.com/photo-1547683905-f686c993aae5?auto=format&fit=crop&w=800&q=80" alt="@project.Title" class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-500" />
                                }
                                <div class="absolute inset-0 bg-gradient-to-t from-gray-950/60 via-transparent to-transparent"></div>
                                <span class="absolute top-3 left-3 @(project.Status == "Active" ? "bg-emerald-600" : "bg-rose-600") text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                                    @project.Status
                                </span>
                            </div>

                            <!-- Card Body Content -->
                            <div class="p-6 space-y-4">
                                <h3 class="text-lg font-black text-gray-900 leading-snug group-hover:text-emerald-700 transition-colors">
                                    @project.Title
                                </h3>

                                <div class="flex items-center gap-1.5 text-xs text-gray-500 font-semibold">
                                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    <span class="text-gray-700">@project.Location</span>
                                </div>

                                <!-- Dynamic Funding Progress Bar -->
                                <div class="space-y-2 pt-2">
                                    <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden p-0.5 border border-gray-200/50">
                                        <div class="bg-gradient-to-r from-emerald-600 to-emerald-400 h-1.5 rounded-full transition-all duration-500" style="width: @(progressPercent.ToString("0.#"))%"></div>
                                    </div>
                                    <div class="flex justify-between items-center text-xs font-bold">
                                        <span class="text-gray-900 font-black">
                                            R @project.RaisedAmount.ToString("N0")
                                            <span class="text-gray-400 font-normal"> / R @project.TargetAmount.ToString("N0")</span>
                                        </span>
                                        <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200 text-[11px]">
                                            @(progressPercent.ToString("0.#"))%
                                        </span>
                                    </div>
                                </div>

                                <!-- Optional Video Link -->
                                @if (!string.IsNullOrEmpty(project.VideoUrl))
                                {
                                    <div class="pt-1">
                                        <a href="@project.VideoUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-rose-600 hover:text-rose-700 transition-colors">
                                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" /></svg>
                                            Watch Campaign Video
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Card Action CTAs -->
                        <div class="p-6 pt-0 grid grid-cols-2 gap-3">
                            <a asp-controller="Donate" asp-action="Index" asp-route-projectId="@project.ProjectID"
                               class="inline-flex items-center justify-center gap-1 bg-amber-400 hover:bg-amber-500 text-gray-950 font-extrabold py-3 px-4 rounded-xl text-xs transition-all shadow-sm active:scale-95 no-underline">
                                <span>Donate</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </a>
                            <a asp-controller="Volunteer" asp-action="Register" asp-route-projectId="@project.ProjectID"
                               class="inline-flex items-center justify-center bg-white border border-gray-200 hover:bg-gray-50 text-gray-800 font-bold py-3 px-4 rounded-xl text-xs transition-all active:scale-95 no-underline">
                                Volunteer
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16 bg-white rounded-2xl border border-gray-200/80 shadow-sm space-y-3">
                <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                <h3 class="text-base font-bold text-gray-800">No Operations Found</h3>
                <p class="text-gray-500 text-xs max-w-sm mx-auto">There are currently no active relief projects available.</p>
            </div>
        }

    </div>
</section>

<!-- Core Pillars Section -->
<section class="py-20 bg-white font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Our Core Pillars</span>
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">How We Serve Communities</h2>
            <p class="text-sm sm:text-base text-gray-600">Rapid emergency response, sustainable community upliftment, and complete donor accountability.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            <!-- Pillar 1 -->
            <div class="bg-gray-50/50 p-8 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Rapid Response</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Deploying specialized medical teams, food parcels, and clean water within hours of natural disasters or localized emergencies.
                </p>
            </div>

            <!-- Pillar 2 -->
            <div class="bg-gray-50/50 p-8 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
                <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Volunteer Network</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Mobilizing thousands of passionate volunteers across medical, logistics, driving, and administrative disciplines.
                </p>
            </div>

            <!-- Pillar 3 -->
            <div class="bg-gray-50/50 p-8 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
                <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Section 18A Tax Certificates</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Full transparency with immediate official tax receipt generation for every monetary contribution.
                </p>
            </div>

        </div>

    </div>
</section>