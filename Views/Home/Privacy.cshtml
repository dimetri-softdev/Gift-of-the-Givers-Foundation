@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="py-12 bg-gray-50/50 min-h-screen font-sans">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Top Header Card -->
        <div class="bg-gradient-to-r from-gray-900 via-gray-800 to-emerald-950 text-white p-8 rounded-2xl shadow-xl mb-8 border border-gray-800">
            <div class="space-y-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Legal & Compliance
                </span>
                <h1 class="text-3xl font-black tracking-tight">@ViewData["Title"]</h1>
                <p class="text-xs sm:text-sm text-gray-400">Last updated: August 2026. How Gift of the Givers protects donor and volunteer personal information.</p>
            </div>
        </div>

        <!-- Privacy Content Container -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200/80 p-6 sm:p-10 space-y-8 text-gray-700 text-sm leading-relaxed">

            <!-- Section 1: Overview -->
            <div class="space-y-3">
                <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                    1. Overview & Commitment
                </h2>
                <p>
                    Gift of the Givers Foundation is committed to protecting your privacy and ensuring that your personal information is handled in a safe, lawful, and responsible manner. This policy details how we collect, use, and safeguard personal data submitted through our online portal, including donor contributions and volunteer applications.
                </p>
            </div>

            <!-- Section 2: Data We Collect -->
            <div class="space-y-3 pt-4 border-t border-gray-100">
                <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                    2. Information We Collect
                </h2>
                <p>We collect personal information necessary to process humanitarian donations, issue official tax certificates, and coordinate emergency volunteer deployments:</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                    <li class="bg-gray-50 p-3.5 rounded-xl border border-gray-100 font-medium text-xs text-gray-800 flex items-start gap-2">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        <span><strong>Donor Details:</strong> Full name, email address, contact phone number, and monetary contribution records.</span>
                    </li>
                    <li class="bg-gray-50 p-3.5 rounded-xl border border-gray-100 font-medium text-xs text-gray-800 flex items-start gap-2">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        <span><strong>Tax Issuance Data:</strong> Tax identification/RSA ID numbers required for Section 18A tax receipts.</span>
                    </li>
                    <li class="bg-gray-50 p-3.5 rounded-xl border border-gray-100 font-medium text-xs text-gray-800 flex items-start gap-2">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        <span><strong>Volunteer Profiles:</strong> Geographic region, medical/logistical skill categories, and shift availability.</span>
                    </li>
                    <li class="bg-gray-50 p-3.5 rounded-xl border border-gray-100 font-medium text-xs text-gray-800 flex items-start gap-2">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        <span><strong>System Logs:</strong> Standard web traffic diagnostics and form interaction metrics.</span>
                    </li>
                </ul>
            </div>

            <!-- Section 3: How Information is Used -->
            <div class="space-y-3 pt-4 border-t border-gray-100">
                <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                    3. How We Use Your Data
                </h2>
                <p>Your information is strictly used to fulfill disaster relief operations, specifically to:</p>
                <ol class="list-decimal pl-5 space-y-1.5 text-xs text-gray-600 font-medium">
                    <li>Process financial and goods-based donations securely.</li>
                    <li>Generate and email Section 18A tax certificates for registered contributions.</li>
                    <li>Coordinate emergency response teams and match volunteers to active relief campaigns.</li>
                    <li>Provide operational disaster relief updates and campaign reporting.</li>
                </ol>
            </div>

            <!-- Section 4: Data Protection & Sharing -->
            <div class="space-y-3 pt-4 border-t border-gray-100">
                <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                    4. Data Security & Non-Disclosure
                </h2>
                <p>
                    Gift of the Givers <strong>never sells, rents, or trades</strong> personal data to third parties or marketing brokers. All data transmission across this platform is protected using HTTPS encryption protocols. Information access is limited strictly to authorized operations personnel.
                </p>
            </div>

            <!-- Section 5: Contact -->
            <div class="pt-4 border-t border-gray-100 bg-emerald-50/50 -mx-6 -mb-6 p-6 sm:-mx-10 sm:-mb-10 rounded-b-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h3 class="text-sm font-bold text-gray-900">Have questions about your data?</h3>
                    <p class="text-xs text-gray-600 mt-0.5">Contact our compliance officers regarding POPIA requests or account removal.</p>
                </div>
                <a href="mailto:info@giftofthegivers.org" class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-5 py-2.5 rounded-xl transition-all shadow-md active:scale-95 no-underline shrink-0">
                    Contact Privacy Officer
                </a>
            </div>

        </div>
    </div>
</section>