@{
    ViewData["Title"] = "About Us";
}

<section class="bg-slate-950 py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-10 lg:grid-cols-2">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-emerald-300">Serving Humanity Unconditionally</span>
                <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">African Disaster Relief &amp; Humanitarian Action</h1>
                <p class="mt-6 text-base leading-relaxed text-slate-300 sm:text-lg">
                    Gift of the Givers Foundation is the largest disaster response non-governmental organization of African origin on the African continent. We deliver life-saving aid where need is greatest.
                </p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                    <p class="text-3xl font-black text-amber-300">R6.0B+</p>
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-300">Aid delivered</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                    <p class="text-3xl font-black text-emerald-300">45+</p>
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-300">Countries reached</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                    <p class="text-3xl font-black text-white">@ViewBag.ActiveProjectsCount</p>
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-300">Active operations</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                    <p class="text-3xl font-black text-amber-300">100%</p>
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-300">Direct impact</p>
                </div>
            </div>
        </div>

        <div class="mt-12 grid gap-6 border-t border-white/10 pt-10 md:grid-cols-2">
            <article>
                <h2 class="text-xl font-black text-white">Our Mission</h2>
                <p class="mt-3 text-sm leading-relaxed text-slate-300">
                    To make a real difference by bringing hope, restoring dignity, and providing rapid emergency medical, food, and water relief to victims of disasters regardless of race, religion, or political affiliation.
                </p>
            </article>
            <article>
                <h2 class="text-xl font-black text-white">Our Vision</h2>
                <p class="mt-3 text-sm leading-relaxed text-slate-300">
                    Building resilient communities across South Africa and the globe through sustainable water borehole projects, medical support infrastructure, education bursaries, and proactive disaster readiness.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="bg-gray-50 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 max-w-2xl">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Our Work</span>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-gray-900">How We Make an Impact</h2>
            <p class="mt-3 text-sm text-gray-600">Key focus areas driving our relief initiatives.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
            <article class="rounded-2xl border border-gray-200 bg-white p-7 shadow-sm">
                <span class="text-xs font-black uppercase tracking-widest text-emerald-700">01</span>
                <h3 class="mt-3 text-lg font-black text-gray-900">Search &amp; Search Relief</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">Deploying specialized search-and-rescue teams, medical doctors, and field hospitals to earthquake, flood, and war zones within hours.</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white p-7 shadow-sm">
                <span class="text-xs font-black uppercase tracking-widest text-emerald-700">02</span>
                <h3 class="mt-3 text-lg font-black text-gray-900">Water Provision</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">Drilling boreholes, installing filtration plants, and deploying water tankers to drought-stricken hospitals, schools, and rural towns.</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white p-7 shadow-sm">
                <span class="text-xs font-black uppercase tracking-widest text-emerald-700">03</span>
                <h3 class="mt-3 text-lg font-black text-gray-900">Food &amp; Social Aid</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">Distributing emergency food parcels, agricultural seed packs, and supporting community feeding centers across vulnerable regions.</p>
            </article>
        </div>
    </div>
</section>

<section class="bg-white py-12">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div>
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Tax Deductible Giving</span>
            <h2 class="mt-2 text-2xl font-black text-gray-900">PBO &amp; Section 18A Approved</h2>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-gray-600">
                All financial contributions to Gift of the Givers qualify for a Section 18A Tax Certificate. South African taxpayers can claim tax deductions on bona fide donations.
            </p>
        </div>
        <a asp-controller="Donate" asp-action="Index" class="inline-flex shrink-0 justify-center rounded-xl bg-amber-400 px-6 py-3 text-sm font-extrabold text-gray-950 transition hover:bg-amber-500">
            Donate Now
        </a>
    </div>
</section>
