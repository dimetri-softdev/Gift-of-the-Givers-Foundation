<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers Foundation</title>
    <meta name="description" content="Gift of the Givers Foundation - The largest disaster response organisation of African origin on the African continent." />

    <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome 6 CDN for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        fontFamily: {
        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
        heading: ['"Outfit"', 'sans-serif'],
        },
        colors: {
        brand: {
        50: '#ecfdf5',
        100: '#d1fae5',
        500: '#10b981',
        600: '#059669',
        700: '#047857',
        800: '#065f46',
        900: '#064e3b',
        }
        }
        }
        }
        }
    </script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiftOfTheGivers.styles.css" asp-append-version="true" />
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">

    <!-- Accessibility: Skip to Main Content Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-emerald-700 focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none">
        Skip to main content
    </a>

    <!-- Top Utility & Emergency Banner -->
    <div class="bg-gradient-to-r from-red-700 via-red-600 to-red-700 text-white text-xs font-medium py-2 px-4 shadow-inner">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center space-x-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-white text-red-700 uppercase tracking-wider animate-pulse">
                    <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-red-600 inline-block"></span>
                    Active Emergency
                </span>
                <span class="font-semibold text-slate-100">KZN Flood Relief</span>
                <span class="hidden sm:inline text-red-200">&mdash; Urgent emergency supplies & clean water distribution underway.</span>
            </div>
            <a asp-controller="Donate" asp-action="Index" class="inline-flex items-center font-bold text-amber-300 hover:text-white transition-colors underline underline-offset-2">
                Support Relief Efforts <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]"></i>
            </a>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40 shadow-sm transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

            <!-- Brand Logo -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-3 group no-underline focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg p-1">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white font-heading font-extrabold text-xl shadow-md group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-hand-holding-heart text-lg"></i>
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-heading font-bold text-slate-900 tracking-tight leading-none group-hover:text-emerald-700 transition-colors">
                        Gift of the Givers
                    </span>
                    <span class="text-[11px] text-slate-500 font-semibold tracking-wider uppercase mt-1">
                        Foundation &bull; <span class="text-emerald-600 font-bold">Section 18A NPO</span>
                    </span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden lg:flex items-center space-x-1 text-sm font-semibold text-slate-700">
                <a asp-controller="Home" asp-action="Index"
                   class="px-3.5 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition-all no-underline">
                    Home
                </a>
                <a asp-controller="Project" asp-action="Index"
                   class="px-3.5 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition-all no-underline">
                    Disaster Projects
                </a>
                <a asp-controller="Donate" asp-action="Index"
                   class="px-3.5 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition-all no-underline">
                    Ways to Give
                </a>
                <a asp-controller="Volunteer" asp-action="Register"
                   class="px-3.5 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition-all no-underline">
                    Volunteer
                </a>

                @if (User.IsInRole("Employee"))
                {
                    <a asp-controller="Employee" asp-action="Index"
                       class="ml-2 inline-flex items-center space-x-1.5 bg-slate-900 hover:bg-slate-800 text-emerald-400 font-bold px-3.5 py-2 rounded-lg text-xs shadow-sm transition-all no-underline">
                        <i class="fa-solid fa-shield-halved text-xs"></i>
                        <span>Employee Portal</span>
                    </a>
                }
            </nav>

            <!-- Header CTA & Authentication Actions -->
            <div class="hidden sm:flex items-center space-x-3">
                <partial name="_LoginPartial" />
                <a asp-controller="Donate" asp-action="Index"
                   class="inline-flex items-center space-x-2 text-xs font-bold text-slate-900 bg-amber-400 hover:bg-amber-300 active:bg-amber-500 px-4 py-2.5 rounded-lg shadow-sm hover:shadow transition-all no-underline transform active:scale-95">
                    <i class="fa-solid fa-heart text-red-600"></i>
                    <span>Donate Now</span>
                </a>
            </div>

            <!-- Mobile Menu Toggle Button -->
            <div class="flex items-center lg:hidden space-x-2">
                <a asp-controller="Donate" asp-action="Index"
                   class="sm:hidden text-xs font-bold text-slate-900 bg-amber-400 hover:bg-amber-300 px-3 py-2 rounded-lg shadow-sm no-underline">
                    Donate
                </a>
                <button type="button" id="mobile-menu-btn"
                        class="p-2.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                        aria-label="Toggle navigation menu" aria-expanded="false">
                    <i class="fa-solid fa-bars text-xl" id="menu-icon-bars"></i>
                    <i class="fa-solid fa-xmark text-xl hidden" id="menu-icon-close"></i>
                </button>
            </div>

        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg">
            <a asp-controller="Home" asp-action="Index"
               class="block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors no-underline">
                <i class="fa-solid fa-house w-6 text-slate-400"></i> Home
            </a>
            <a asp-controller="Project" asp-action="Index"
               class="block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors no-underline">
                <i class="fa-solid fa-hand-holding-hand w-6 text-slate-400"></i> Disaster Projects
            </a>
            <a asp-controller="Donate" asp-action="Index"
               class="block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors no-underline">
                <i class="fa-solid fa-circle-dollar-to-slot w-6 text-slate-400"></i> Ways to Give
            </a>
            <a asp-controller="Volunteer" asp-action="Register"
               class="block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors no-underline">
                <i class="fa-solid fa-users w-6 text-slate-400"></i> Volunteer
            </a>

            @if (User.IsInRole("Employee"))
            {
                <a asp-controller="Employee" asp-action="Index"
                   class="block px-3 py-2.5 rounded-lg text-base font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 transition-colors no-underline">
                    <i class="fa-solid fa-shield-halved w-6 text-emerald-600"></i> Employee Dashboard
                </a>
            }

            <div class="pt-4 border-t border-slate-100 flex flex-col space-y-3">
                <partial name="_LoginPartial" />
                <a asp-controller="Donate" asp-action="Index"
                   class="w-full text-center text-sm font-bold text-slate-900 bg-amber-400 hover:bg-amber-300 py-3 rounded-lg shadow-sm transition-colors no-underline">
                    <i class="fa-solid fa-heart text-red-600 mr-1.5"></i> Donate Now
                </a>
            </div>
        </div>
    </header>

    <!-- TempData Notification Alerts -->
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 text-sm font-medium text-emerald-900 bg-emerald-50 rounded-xl border border-emerald-200 shadow-sm flex items-start justify-between gap-3 animate-fade-in">
                <div class="flex items-center space-x-3">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-lg flex-shrink-0"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" onclick="this.closest('div').remove()" class="text-emerald-700 hover:text-emerald-900 font-bold p-1 rounded-lg hover:bg-emerald-100 transition-colors">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 text-sm font-medium text-red-900 bg-red-50 rounded-xl border border-red-200 shadow-sm flex items-start justify-between gap-3 animate-fade-in">
                <div class="flex items-center space-x-3">
                    <i class="fa-solid fa-triangle-exclamation text-red-600 text-lg flex-shrink-0"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" onclick="this.closest('div').remove()" class="text-red-700 hover:text-red-900 font-bold p-1 rounded-lg hover:bg-red-100 transition-colors">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="p-4 text-sm font-medium text-amber-900 bg-amber-50 rounded-xl border border-amber-200 shadow-sm flex items-start justify-between gap-3 animate-fade-in">
                <div class="flex items-center space-x-3">
                    <i class="fa-solid fa-circle-exclamation text-amber-600 text-lg flex-shrink-0"></i>
                    <span>@TempData["WarningMessage"]</span>
                </div>
                <button type="button" onclick="this.closest('div').remove()" class="text-amber-700 hover:text-amber-900 font-bold p-1 rounded-lg hover:bg-amber-100 transition-colors">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main id="main-content" role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Main Footer -->
    <footer class="bg-slate-950 text-slate-400 border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">

                <!-- Organization Bio -->
                <div class="space-y-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-base shadow">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                        </div>
                        <span class="text-lg font-heading font-bold text-white">Gift of the Givers</span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        The largest disaster response organisation of African origin on the African continent. Delivering life-saving medical aid, food relief, clean water, and humanitarian hope worldwide.
                    </p>
                    <div class="pt-1 text-xs text-slate-500 font-mono">
                        NPO Registration: <span class="text-slate-300">028-869-NPO</span><br />
                        PBO / Section 18A Tax Exempt: <span class="text-slate-300">930018993</span>
                    </div>
                </div>

                <!-- Quick Navigation -->
                <div>
                    <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-4 font-heading">Quick Links</h3>
                    <ul class="space-y-2.5 text-xs">
                        <li><a asp-controller="Home" asp-action="Index" class="hover:text-emerald-400 transition-colors no-underline">Home</a></li>
                        <li><a asp-controller="Project" asp-action="Index" class="hover:text-emerald-400 transition-colors no-underline">Disaster Relief Projects</a></li>
                        <li><a asp-controller="Donate" asp-action="Index" class="hover:text-emerald-400 transition-colors no-underline">Make a Tax-Deductible Donation</a></li>
                        <li><a asp-controller="Volunteer" asp-action="Register" class="hover:text-emerald-400 transition-colors no-underline">Become a Volunteer</a></li>
                        <li><a href="#" class="hover:text-emerald-400 transition-colors no-underline">Financial Transparency & Audits</a></li>
                    </ul>
                </div>

                <!-- Emergency Relief Operations -->
                <div>
                    <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-4 font-heading">Active Relief Missions</h3>
                    <ul class="space-y-2.5 text-xs">
                        <li><a href="#" class="hover:text-emerald-400 transition-colors no-underline flex items-center justify-between"><span>KZN Flood Response</span> <span class="text-[10px] bg-red-900/60 text-red-300 px-1.5 py-0.5 rounded font-mono">URGENT</span></a></li>
                        <li><a href="#" class="hover:text-emerald-400 transition-colors no-underline">Drought & Borehole Water Provision</a></li>
                        <li><a href="#" class="hover:text-emerald-400 transition-colors no-underline">Healthcare & Surgical Interventions</a></li>
                        <li><a href="#" class="hover:text-emerald-400 transition-colors no-underline">School Feeding & Nutrition Programs</a></li>
                        <li><a href="#" class="hover:text-emerald-400 transition-colors no-underline">International Search and Rescue</a></li>
                    </ul>
                </div>

                <!-- Contact & Social Media -->
                <div>
                    <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-4 font-heading">Connect With Us</h3>
                    <div class="space-y-3 text-xs">
                        <p class="flex items-start space-x-2">
                            <i class="fa-solid fa-phone text-emerald-500 mt-0.5"></i>
                            <span>Toll Free Emergency: <strong>0800 786 911</strong></span>
                        </p>
                        <p class="flex items-start space-x-2">
                            <i class="fa-solid fa-envelope text-emerald-500 mt-0.5"></i>
                            <span>info@giftofthegivers.org</span>
                        </p>
                        <p class="flex items-start space-x-2">
                            <i class="fa-solid fa-location-dot text-emerald-500 mt-0.5"></i>
                            <span>Pietermaritzburg, KwaZulu-Natal, South Africa</span>
                        </p>
                    </div>

                    <div class="mt-5 flex space-x-3">
                        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f text-xs"></i>
                        </a>
                        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors" aria-label="X Twitter">
                            <i class="fa-brands fa-x-twitter text-xs"></i>
                        </a>
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors" aria-label="Instagram">
                            <i class="fa-brands fa-instagram text-xs"></i>
                        </a>
                        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors" aria-label="LinkedIn">
                            <i class="fa-brands fa-linkedin-in text-xs"></i>
                        </a>
                        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors" aria-label="YouTube">
                            <i class="fa-brands fa-youtube text-xs"></i>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Bottom Sub-Footer -->
            <div class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
                <div class="text-slate-500 text-center sm:text-left">
                    &copy; @DateTime.Now.Year <span class="font-bold text-slate-300">Gift of the Givers Foundation</span>. All rights reserved.
                </div>
                <div class="flex flex-wrap justify-center space-x-6 text-slate-500">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-emerald-400 transition-colors no-underline">Privacy Policy</a>
                    <a href="#" class="hover:text-emerald-400 transition-colors no-underline">Terms of Service</a>
                    <a href="#" class="hover:text-emerald-400 transition-colors no-underline">Section 18A Tax Info</a>
                    <a href="#" class="hover:text-emerald-400 transition-colors no-underline">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Layout Navigation Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const barsIcon = document.getElementById('menu-icon-bars');
        const closeIcon = document.getElementById('menu-icon-close');

        if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', function () {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', !isExpanded);
        mobileMenu.classList.toggle('hidden');
        barsIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
        });
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!--
### Key Improvements Made:
1. **Responsive Mobile Menu**: Added a functional, mobile-friendly hamburger drawer navigation with standard smooth toggle logic.
2. **Branded Aesthetics**: Applied custom Google Fonts (`Outfit` for headings and `Plus Jakarta Sans` for body) with clean Emerald (`#10b981`) and Amber (`#fbbf24`) NGO colors.
3. **Icons & Accessibility**: Included FontAwesome 6 icons, ARIA attributes, skip-to-content links, and clear keyboard focus styles.
4. **Expanded Alert Banners**: Enhanced `TempData` handling to seamlessly support Success, Error, and Warning message banners with icons and dismiss controls.
5. **Rich NGO Footer**: Added Section 18A PBO details, emergency numbers, active relief campaign shortcuts, and social media links.
-->
