<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>

    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiftOfTheGivers.styles.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col font-sans">

    <!-- Emergency Top Banner -->
    <div class="bg-red-600 text-white text-xs font-semibold py-2 px-4 text-center tracking-wide shadow-inner">
        <span class="uppercase font-bold tracking-wider">🚨 Active Emergency:</span>
        KZN Flood Relief — Donations urgently needed.
        <a asp-controller="Home" asp-action="Donate" class="underline hover:text-red-100 font-bold ml-1">Give now &rarr;</a>
    </div>

    <!-- Main Navigation Bar -->
    <header class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

            <!-- Brand Logo -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-3 no-underline">
                <div class="w-10 h-10 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-lg shadow">
                    G
                </div>
                <div>
                    <span class="block text-lg font-bold text-gray-900 leading-none">Gift of the Givers</span>
                    <span class="text-xs text-gray-500 font-medium">Foundation</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex space-x-8 text-sm font-medium text-gray-700">
                <a asp-controller="Home" asp-action="Index" class="hover:text-emerald-600 transition-colors no-underline">Home</a>
                <a asp-controller="Projects" asp-action="Index" class="hover:text-emerald-600 transition-colors no-underline">Disaster Projects</a>
                <a asp-controller="Donate" asp-action="Index" class="hover:text-emerald-600 transition-colors no-underline">Donate</a>
                <a asp-controller="Volunteer" asp-action="Index" class="hover:text-emerald-600 transition-colors no-underline">Volunteer</a>
                <a asp-controller="Dashboard" asp-action="Index" class="hover:text-emerald-600 transition-colors no-underline">Employee Dashboard</a>
            </nav>

            <!-- Header CTA Actions -->
            <div class="flex items-center space-x-3">
                <a asp-controller="Account" asp-action="Login" class="text-xs font-semibold text-gray-700 hover:text-emerald-600 px-3 py-2 no-underline">Log in</a>
                <a asp-controller="Account" asp-action="Register" class="text-xs font-semibold text-emerald-700 border border-emerald-600 px-4 py-2 rounded-md hover:bg-emerald-50 transition-colors no-underline">Register</a>
                <a asp-controller="Donate" asp-action="Index" class="text-xs font-bold text-gray-900 bg-amber-400 hover:bg-amber-500 px-4 py-2 rounded-md shadow-sm transition-colors no-underline">Donate Now</a>
            </div>

        </div>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 border-t border-gray-800 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0 text-xs">
            <div>
                &copy; @DateTime.Now.Year - <span class="font-bold text-white">Gift of the Givers Foundation</span>. All rights reserved.
            </div>
            <div class="flex space-x-6">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-emerald-400 transition-colors no-underline">Privacy Policy</a>
                <a href="#" class="hover:text-emerald-400 transition-colors no-underline">Terms of Service</a>
                <a href="#" class="hover:text-emerald-400 transition-colors no-underline">Contact Us</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>