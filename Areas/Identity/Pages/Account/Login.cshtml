@page
@model LoginModel
@{
    ViewData["Title"] = "Welcome Back";
}

<section class="min-h-[70vh] bg-slate-50 px-4 py-12 sm:py-16">
    <div class="mx-auto grid max-w-5xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl md:grid-cols-2">
        <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-emerald-950 p-8 text-white sm:p-10">
            <span class="inline-flex rounded-full border border-emerald-300/30 bg-emerald-300/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-emerald-200">Welcome back</span>
            <h1 class="mt-6 text-3xl font-black tracking-tight sm:text-4xl">Welcome Back</h1>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">Please sign in to access your account.</p>
            <div class="mt-10 border-t border-white/10 pt-6">
                <p class="text-sm font-bold text-white">Gift of the Givers Foundation</p>
                <p class="mt-2 text-xs leading-relaxed text-slate-400">Serving humanity unconditionally through emergency response and humanitarian aid.</p>
            </div>
        </div>

        <div class="p-8 sm:p-10">
            <h2 class="text-xl font-black text-slate-900">Sign in to your account</h2>
            <p class="mt-2 text-sm text-slate-600">Enter the email address and password associated with your account.</p>

            <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-950">
                <p class="font-bold">Lecturer Evaluation Credentials</p>
                <p class="mt-1 text-emerald-900">Use this account to review the employee and administrative dashboard capabilities:</p>
                <dl class="mt-3 space-y-1">
                    <div class="flex flex-wrap gap-1">
                        <dt class="font-semibold">Email:</dt>
                        <dd>employee@giftofthegivers.org</dd>
                    </div>
                    <div class="flex flex-wrap gap-1">
                        <dt class="font-semibold">Password:</dt>
                        <dd>Password123!</dd>
                    </div>
                </dl>
            </div>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="mt-7 space-y-5">
                <div asp-validation-summary="ModelOnly" role="alert" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></div>
                <div>
                    <label asp-for="Input.Email" class="mb-2 block text-xs font-bold text-slate-700">Email address</label>
                    <input asp-for="Input.Email" placeholder="name@example.com" autocomplete="username" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-100" />
                    <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Input.Password" class="mb-2 block text-xs font-bold text-slate-700">Password</label>
                    <input asp-for="Input.Password" placeholder="••••••••" autocomplete="current-password" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-100" />
                    <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <label asp-for="Input.RememberMe" class="flex items-center gap-2 text-sm text-slate-600">
                    <input asp-for="Input.RememberMe" class="rounded border-slate-300 text-emerald-700 focus:ring-emerald-600" />
                    Remember me
                </label>
                <button id="login-submit" type="submit" class="w-full rounded-xl bg-emerald-700 px-5 py-3.5 text-sm font-extrabold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
                    Sign In
                </button>
            </form>

            <div class="mt-6 flex flex-wrap justify-between gap-3 border-t border-slate-100 pt-5 text-sm">
                <a asp-page="./ForgotPassword" class="font-semibold text-slate-600 hover:text-emerald-800">Forgot password?</a>
                <span class="text-slate-600">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-emerald-800 hover:text-emerald-950">Register here</a></span>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
